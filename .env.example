DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Supabase (public) — used by the browser and the Proxy/middleware.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# Public anon key (Project Settings → API → anon/public). Safe in the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Supabase (server-only) — service role key. Never expose to the client.
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

SEED_SUPER_ADMIN_EMAIL="president@fhusocom.edu"
SEED_SUPER_ADMIN_PASSWORD="Skadmin123!"
SEED_SUPER_ADMIN_NAME="President"

# Upstash Redis — used for application-level caching (read paths + invalidation on writes).
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-URL].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-REST-TOKEN]"
