{
  "name": "fhusocom",
  "version": "0.1.0",
  "private": true,
  "description": "Student Government Management System — monorepo (Next.js web + Expo mobile + Prisma db)",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fhusocom/web",
    "build": "npm run build -w @fhusocom/web",
    "lint": "npm run lint -w @fhusocom/web",
    "db:generate": "npm run generate -w @fhusocom/db",
    "db:validate": "npm run validate -w @fhusocom/db",
    "db:migrate": "npm run migrate -w @fhusocom/db",
    "db:seed": "npm run seed -w @fhusocom/db",
    "test": "npm run test -w @fhusocom/web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
